[Unit]
Description=GrantEd Admissions CRM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grantedcrm
Group=grantedcrm
WorkingDirectory=/opt/granted-crm
EnvironmentFile=/etc/granted-crm.env
ExecStart=/usr/bin/node --env-file-if-exists=/etc/granted-crm.env server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/granted-crm/data

[Install]
WantedBy=multi-user.target
